        "cpuLimit": "1.0",
        "memoryLimit": "2G",
        "cpuReservation": "0.5",
        "memoryReservation": "1G"
      }
    },
    "logstash": {
      "image": "docker.elastic.co/logstash/logstash:8.9.1",
      "port": 5000,
      "exposed": true,
      "publicAccess": false,
      "inputFormats": ["syslog", "JSON"],
      "resources": {
        "cpuLimit": "1.0",
        "memoryLimit": "2G",
        "cpuReservation": "0.5",
        "memoryReservation": "1G"
      }
    },
    "nginx": {
      "image": "nginx:1.25-alpine",
      "port": 8080,
      "exposed": false,
      "publicAccess": true,
      "hostPort": 80,
